{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoneSender",
  "mainBinaryName": "StoneSender",
  "version": "../package.json",
  "identifier": "com.chantzmakes.stonesender",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StoneSender",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Chantz Tribe",
    "shortDescription": "G-code sender, visualizer and simulator for GRBL machines",
    "longDescription": "StoneSender sends G-code to GRBL / grblHAL CNC routers and lasers, shows the toolpath and a simulation of the cut in 3D, estimates job time and checks jobs against your machine before they run.",
    "category": "Productivity",
    "homepage": "https://github.com/ChantzMakes/StoneSender",
    "copyright": "© 2026 Chantz Tribe",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libudev1"
        ]
      },
      "rpm": {
        "depends": [
          "systemd-libs"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBREU3NTRFOEUxQjIxMzcKUldRM0lSdU9UblhlK2tHTUVkVzE1Wnh6cjVrL21YVTRFTDRkRVFWaHRjcXlnR2hwNTc1R1AvdUMK",
      "endpoints": [
        "https://github.com/ChantzMakes/StoneSender/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
